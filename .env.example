# Copy this file to .env only when .env does not already exist.
# The first web startup hashes this one-time password, creates the single admin
# only if none exists, then removes the password from the process and env file.
HIREVIA_ADMIN_EMAIL=your-email@example.com
HIREVIA_ADMIN_PASSWORD=your-strong-password

# Leave blank to generate and persist once during initial bootstrap.
HIREVIA_SESSION_SECRET=
HIREVIA_AUTH_DB_PATH=hirevia_auth.db

# Local loopback defaults. Production requires HTTPS and COOKIE_SECURE=true.
HIREVIA_ENV=development
HIREVIA_COOKIE_SECURE=false
HIREVIA_ALLOWED_HOSTS=localhost,127.0.0.1
HIREVIA_SESSION_TTL_SECONDS=28800