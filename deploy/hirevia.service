[Unit]
Description=Hirevia Telegram Job Discovery Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hirevia
Group=hirevia
WorkingDirectory=/etc/hirevia
EnvironmentFile=-/etc/hirevia/hirevia.env
Environment=HIREVIA_HOST=127.0.0.1
Environment=HIREVIA_PORT=8000
Environment=HIREVIA_DB_PATH=/var/lib/hirevia/hirevia.db
Environment=TELEGRAM_SESSION_DIR=/var/lib/hirevia/sessions
Environment=HIREVIA_LOG_DIR=/var/log/hirevia
ExecStart=/opt/hirevia/.venv/bin/python -m hirevia
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=45
UMask=0077
StateDirectory=hirevia
StateDirectoryMode=0700
LogsDirectory=hirevia
LogsDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/hirevia /var/lib/hirevia /var/log/hirevia

[Install]
WantedBy=multi-user.target
